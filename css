background-image: url("https://res.cloudinary.com/dk2vcuazz/video/upload/v1763503219/Vid%C3%A9o_sans_titre_balmso.mp4");
background-size: cover;
background-position: center;
/* Conteneur qui couvre tout l’écran */
.video-background {
  position: fixed; 
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  z-index: -1;
}

/* Vidéo responsive FULLSCREEN */
.video-background video {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover; /* clé pour mobile */
  object-position: center;
}

