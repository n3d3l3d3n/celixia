background-image: url("https://res.cloudinary.com/dk2vcuazz/video/upload/v1763503219/Vid%C3%A9o_sans_titre_balmso.mp4");
background-size: cover;
background-position: center;
.video-bg {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 100vh;
    transform: translate(-50%, -50%);
    object-fit: cover;
    z-index: 0;
}

/* iPhone Safari fix */
@supports (-webkit-touch-callout: none) {
    .video-bg {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }
}

/* FULL MOBILE FIX */
@media (max-width: 768px) {
    .video-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: translate(-50%, -50%);
    }
}
